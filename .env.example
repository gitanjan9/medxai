# ──────────────────────────────────────────────────────────────────────────────
# MedicalXAI – environment variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=80
WEB_CONCURRENCY=2

# ── Model ─────────────────────────────────────────────────────────────────────
MEDXAI_ARCH=efficientnet_b3
MEDXAI_IMAGE_SIZE=320
MEDXAI_MODEL_VERSION=v2-efficientnet-b3-320
MEDXAI_PRIMARY_MODEL=txrv
MEDXAI_OOD_ENABLED=true

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# HttpOnly cookie settings
COOKIE_SECURE=true        # set to false for local http dev
COOKIE_SAMESITE=lax

# Allow public user registration (false = admin-invite only)
MEDXAI_OPEN_REGISTRATION=false

# ── Admin ─────────────────────────────────────────────────────────────────────
MEDXAI_ADMIN_SECRET=CHANGE_ME

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=medxai
POSTGRES_USER=medxai
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Inside Docker (service name = postgres)
DATABASE_URL=postgresql://medxai:CHANGE_ME_strong_password@postgres:5432/medxai
# Local dev (outside Docker)
# DATABASE_URL=postgresql://medxai:CHANGE_ME_strong_password@localhost:5432/medxai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Local dev
# REDIS_URL=redis://localhost:6379/0

# ── File storage (AWS S3 or Cloudflare R2) ────────────────────────────────────
# Leave blank to use local disk storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For Cloudflare R2, set the endpoint URL:
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=

# ── OpenAI (optional: chat fallback) ─────────────────────────────────────────
OPENAI_API_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production   # dev | staging | production
