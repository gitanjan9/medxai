{
  "schema": "https://github.com/Project-MONAI/MONAI-extra-test-data/releases/download/0.8.1/meta_schema_20220324.json",
  "version": "0.1.0",
  "changelog": {
    "0.1.0": "Day 1 – initial training pipeline"
  },
  "monai_version": "1.3.0",
  "pytorch_version": "2.1.0",
  "numpy_version": "1.24.0",
  "optional_packages_version": {
    "timm": "0.9.0",
    "mlflow": "2.10.0"
  },
  "name": "mimic_cxr_classifier",
  "task": "classification",
  "medical_specialty": "radiology",
  "image_classes": "grayscale chest X-ray",
  "target_classes": "17-class chest X-ray impression classification",
  "description": "Chest X-ray classifier trained on MIMIC-CXR to predict radiology impression categories.",
  "authors": "MedicalXAI Team",
  "copyright": "Apache-2.0",
  "data_source": "MIMIC-CXR (PhysioNet)",
  "network_data_format": {
    "inputs": {
      "image": {
        "type": "image",
        "format": "grayscale",
        "modality": "X-ray",
        "num_channels": 1,
        "spatial_shape": [224, 224],
        "dtype": "float32",
        "value_range": [0, 1]
      }
    },
    "outputs": {
      "pred": {
        "type": "classification",
        "format": "softmax",
        "num_channels": 17,
        "dtype": "float32"
      }
    }
  }
}
