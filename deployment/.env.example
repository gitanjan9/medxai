# ──────────────────────────────────────────────────────────────────────────────
# MedicalXAI – environment variables example
# Copy to .env (project root) and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# ── Model artifacts ───────────────────────────────────────────────────────────
# These paths are resolved INSIDE the container.
# The docker-compose.yml overrides them; only change if using a custom layout.
MEDXAI_ARCH=efficientnet_b3
MEDXAI_IMAGE_SIZE=320
MEDXAI_MODEL_VERSION=v2-efficientnet-b3-320

# ── Admin ─────────────────────────────────────────────────────────────────────
# Leave empty to disable admin auth (local dev only).
# Set a strong random value in production.
MEDXAI_ADMIN_SECRET=
MEDXAI_ENV=dev                  # dev | prod | test — tags every audit record
MEDXAI_OOD_ENABLED=false           # true → CLIP-based CXR vs non-CXR check
MEDXAI_OOD_ACCEPT_THRESHOLD=0.45  # score >= this → accept (clearly a CXR)
MEDXAI_OOD_REJECT_THRESHOLD=0.20  # score < this  → reject (HTTP 422); between → review + warning
MEDXAI_PATHOLOGY_ENABLED=false    # true → torchxrayvision 18-class pathology detector
MEDXAI_LOCALIZATION_ENABLED=true  # false → skip Grad-CAM bbox extraction in /v1/explain

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=medxai
POSTGRES_USER=medxai
POSTGRES_PASSWORD=changeme_in_production
# Connection URL used by the API (inside Docker: hostname = postgres service name)
DATABASE_URL=postgresql://medxai:changeme_in_production@postgres:5432/medxai
# For local dev (outside Docker):
# DATABASE_URL=postgresql://medxai:changeme_in_production@localhost:5432/medxai

# ── Redis ─────────────────────────────────────────────────────────────────────
# Currently used as an optional dependency.
# REDIS_URL=redis://redis:6379/0
