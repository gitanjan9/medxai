# ──────────────────────────────────────────────────────────────────────────────
# MedicalXAI CXR Inference API – production image
# Base: python:3.12-slim  (stable, minimal, ≈130 MB)
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS base

LABEL org.opencontainers.image.title="MedicalXAI Inference API" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.description="EfficientNet-B3 CXR classifier – FastAPI serve layer"

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── Non-root user ─────────────────────────────────────────────────────────────
RUN groupadd --gid 1001 medxai \
 && useradd  --uid 1001 --gid medxai --shell /bin/bash --create-home medxai

WORKDIR /app

# ── Python deps (installed before copying source for layer caching) ────────────
# Force rebuild: 2026-08-03-18:23
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
        torch==2.2.2 torchvision==0.17.2 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir email-validator>=2.1.0
# ── Source code ───────────────────────────────────────────────────────────────
COPY src/ ./src/
COPY deployment/gunicorn.conf.py ./deployment/

# ── Artifacts (essential config files for model inference) ────────────────────
COPY artifacts/calibration.json ./artifacts/
COPY artifacts/thresholds.json ./artifacts/
COPY artifacts/label_map.json ./artifacts/
COPY artifacts/v2/ ./artifacts/v2/

# ── Permissions ───────────────────────────────────────────────────────────────
RUN chown -R medxai:medxai /app
USER medxai

# ── Runtime ───────────────────────────────────────────────────────────────────
EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["gunicorn", "src.serve.app:app", \
     "-c", "deployment/gunicorn.conf.py", \
     "-k", "uvicorn.workers.UvicornWorker"]
