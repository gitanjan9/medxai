# ──────────────────────────────────────────────────────────────────────────────
# MedicalXAI CXR Inference API – production image
# Base: python:3.12-slim  (stable, minimal, ≈130 MB)
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS base

LABEL org.opencontainers.image.title="MedicalXAI Inference API" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.description="EfficientNet-B3 CXR classifier – FastAPI serve layer"

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── Non-root user ─────────────────────────────────────────────────────────────
RUN groupadd --gid 1001 medxai \
 && useradd  --uid 1001 --gid medxai --shell /bin/bash --create-home medxai

WORKDIR /app

# ── Python deps (installed before copying source for layer caching) ────────────
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
        torch==2.2.2 torchvision==0.17.2 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "gunicorn>=21.2.0" \
        "monai>=1.3.0" \
        "timm>=0.9.0" \
        "Pillow>=10.0.0" \
        "numpy>=1.24.0" \
        "pydantic>=2.0.0" \
        "python-multipart>=0.0.9" \
        "PyYAML>=6.0" \
        "scikit-learn>=1.3.0" \
        "scikit-image>=0.21.0" \
        "opencv-python-headless>=4.8.0" \
        "torchxrayvision>=1.0.0" \
        "psycopg2-binary>=2.9.0" \
        "bcrypt>=4.0.0" \
        "python-jose[cryptography]>=3.3.0" \
        "passlib[bcrypt]>=1.7.0" \
        "redis>=5.0.0" \
        "slowapi>=0.1.9"

# ── Source code ───────────────────────────────────────────────────────────────
COPY src/ ./src/

# ── Artifacts (mounted at runtime; baked in for self-contained image) ──────────
# To bake artifacts into the image, uncomment:
# COPY artifacts/ ./artifacts/

# ── Permissions ───────────────────────────────────────────────────────────────
RUN chown -R medxai:medxai /app
USER medxai

# ── Runtime ───────────────────────────────────────────────────────────────────
EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["gunicorn", "src.serve.app:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--workers", "2", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--log-level", "info"]
